{
  "name": "precision-ui",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test scripts/theme.test.mjs",
    "test:browser": "playwright test",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/package.mjs",
    "prepare": "npm run build:lib",
    "format": "prettier --write src scripts *.json *.ts *.md index.html",
    "test:tailwind": "npm run build:lib && node scripts/tailwind.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "description": "A restrained React and Base UI design system with portable themes and agent guidance.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nihiluis/ui.git"
  },
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./tokens.json": "./dist-lib/tokens.json",
    "./GUI.md": "./GUI.md",
    "./package.json": "./package.json",
    "./tailwind.css": "./dist-lib/tailwind.css"
  },
  "files": [
    "dist-lib",
    "GUI.md",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
